# Kopieer naar .env.local en vul in waar nodig. Zonder deze waarden draait
# de app in "demo-modus": betaling gesimuleerd, e-mails in preview (backoffice → Mailbox).

# --- Auth ---
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=verander-mij-in-een-lange-willekeurige-string

# --- Mollie (iDEAL) — optioneel ---
# Zonder key: interne betaal-simulatie. Met key: echte iDEAL-betaling + webhook.
# MOLLIE_API_KEY=test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- E-mail (SMTP) — optioneel ---
# Zonder SMTP: e-mails worden opgeslagen en getoond in het backoffice (preview).
# Met SMTP: echt versturen (bijv. via Postmark, Resend SMTP, of je eigen server).
# SMTP_HOST=smtp.postmarkapp.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=Mooihuus <info@mooihuus.nl>

# --- Chatbot (Huus-hulp) — optioneel ---
# Zonder key: slimme FAQ-gebaseerde antwoorden (werkt overal).
# Met key: echte LLM-antwoorden via Anthropic.
# ANTHROPIC_API_KEY=sk-ant-...
# CHAT_MODEL=claude-3-5-haiku-latest
